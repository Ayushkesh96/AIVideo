# Copy to docker/.env and fill in. docker compose reads this automatically.

# Required. A long random string — this is the bearer token both the proxy
# and AIVideo's COMFYUI_TOKEN must agree on. Generate one with:
#   openssl rand -hex 32
COMFYUI_TOKEN=

# Port the proxy listens on (what you point AIVideo's COMFYUI_URL at).
LISTEN_PORT=8188

# Where model weights, output clips, input images and ComfyUI's user data
# (settings, saved workflows) live on the host. Defaults are fine for local
# use; point MODELS_PATH at a bigger disk if you're tight on space — weights
# for these models run 2–30 GB each.
# MODELS_PATH=./models
# OUTPUT_PATH=./output
# INPUT_PATH=./input
# USER_DATA_PATH=./user

# Extra custom nodes to install on top of the VideoHelperSuite baked into the
# image, comma-separated git URLs. Only needed for a custom workflow that
# calls for one (e.g. LoRA loaders, a specific model's wrapper nodes).
# EXTRA_CUSTOM_NODES=https://github.com/kijai/ComfyUI-KJNodes

# Extra ComfyUI command-line flags, e.g. --lowvram on an 8-12 GB card.
# COMFYUI_EXTRA_ARGS=--lowvram

# ---------------------------------------------------------------------------
# CogVideoX — a separate, optional service (profile: cogvideox). Only needed
# if you're running `docker compose --profile cogvideox up cogvideox` instead
# of (or alongside) ComfyUI. See cogvideox-server/README.md.
# ---------------------------------------------------------------------------
# Required to start that service at all — openssl rand -hex 32
COGVIDEOX_TOKEN=

# COGVIDEOX_PORT=8189
# COGVIDEOX_MODEL=THUDM/CogVideoX-2b
# COGVIDEOX_FULL_GPU=
# COGVIDEOX_HF_CACHE_PATH=./cogvideox-hf-cache
# COGVIDEOX_OUTPUT_PATH=./cogvideox-output

# ---------------------------------------------------------------------------
# Song Studio (audio, not video) — a separate, optional service pair
# (profile: songgen). `docker compose --profile songgen up songgen songgen-proxy`.
# Needs real VRAM (10GB min, 24GB+ recommended) and ~50GB disk for weights.
# See songgen-server/README.md and ../docs/song-generation.md.
# ---------------------------------------------------------------------------
# Required to start that service pair at all — openssl rand -hex 32
SONGGEN_TOKEN=

# SONGGEN_LISTEN_PORT=8190
# SONGGEN_WEIGHTS_PATH=./songgen-weights
# SONGGEN_HF_CACHE_PATH=./songgen-hf-cache
